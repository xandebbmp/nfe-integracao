# Worker da fila de emissão. Template: um serviço por instância.
#   sudo cp deploy/nfe-worker@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nfe-worker@1 nfe-worker@2
#   journalctl -u 'nfe-worker@*' -f

[Unit]
Description=NFe API - worker de emissao %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/nfe-integracao
ExecStart=/usr/bin/php bin/worker.php
# Se os segredos estiverem em variáveis de ambiente (em vez de config/*.local.php):
# EnvironmentFile=/etc/nfe-api.env

Restart=always
RestartSec=5

# SIGTERM: termina o job atual antes de sair.
KillSignal=SIGTERM
TimeoutStopSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
