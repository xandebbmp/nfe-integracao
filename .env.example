# ============================================================================
# Segredos e configurações do servidor.
#
# Como usar:
#   1. Copie este arquivo para ".env" (na mesma pasta, a raiz do projeto):
#        cp .env.example .env
#   2. Preencha os valores no .env. O .env NUNCA vai para o GitHub
#      (está no .gitignore). Este .env.example vai, por isso fica sem senhas.
#   3. Proteja o arquivo no servidor:  chmod 600 .env
#   4. Reinicie o worker pelo painel (Sistema > Reiniciar worker).
#
# O que estiver preenchido no painel (Sistema > Configurações > E-mail) ou no
# config/nfse.local.php vale mais que este arquivo. Uma variável já definida
# no próprio servidor (systemd, pm2) também vale mais.
# ============================================================================

# ---- E-mail (SMTP) do "Esqueci a senha" do portal ----
# Servidor de e-mail do provedor.
SMTP_HOST=
# 465 = TLS direto (SMTP_SECURE=ssl) | 587 = STARTTLS (SMTP_SECURE=tls)
SMTP_PORT=465
SMTP_SECURE=ssl
# Usuário da conta (geralmente o próprio endereço de e-mail).
SMTP_USER=
# Senha da conta de e-mail. Só aqui, nunca no GitHub.
SMTP_PASSWORD=
# Endereço que aparece como remetente (só o endereço, sem nome nem < >).
SMTP_FROM=

# Endereço público do portal (vai no link do e-mail), ex.:
# PORTAL_URL=https://fiscal.suaempresa.com.br/portal/
PORTAL_URL=
